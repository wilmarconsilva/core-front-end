{
  "name": "core",
  "version": "1.5.1",
  "main": "index.ts",
  "scripts": {
    "setup": "node setup.js",
    "reorganize": "node reorganize.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "preweb": "npm run pwa:sync",
    "web": "expo start --web",
    "web:tunnel": "expo start --web --tunnel",
    "pwa:sync": "tsx scripts/sync-pwa-artifacts.ts",
    "build:web": "npm run pwa:sync && expo export -p web",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration integration:infrastructure"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "^57.0.23",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "idb": "^8.0.3",
    "pdfmake": "^0.3.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-currency-input": "^1.1.1",
    "react-native-mask-input": "^1.2.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "^0.21.2",
    "react-to-print": "^3.3.0",
    "signature_pad": "^5.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.1",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "expo-module-scripts": "~56.0.3",
    "fake-indexeddb": "^6.2.5",
    "jest-expo": "~57.0.5",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  },
  "private": true
}
